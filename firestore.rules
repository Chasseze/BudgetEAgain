rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Only server-side confirmation code may mark a report address as verified.
    function doesNotSetProtectedReportFields() {
      return !request.resource.data.keys().hasAny([
        'reportEmailVerified',
        'reportEmailVerifiedFor'
      ]);
    }

    function protectedReportFieldsAreUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'reportEmailVerified',
        'reportEmailVerifiedFor'
      ]);
    }
    
    // User-specific data rules
    match /users/{userId} {
      // Allow users to read and write their own user document
      allow read, write: if isOwner(userId);
      
      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId);
      }
      
      // Goals subcollection
      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }
      
      // Settings subcollection. A client can manage its preferences but cannot
      // self-verify an arbitrary destination for financial email reports.
      match /settings/{settingId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && (settingId != 'preferences' || doesNotSetProtectedReportFields());
        allow update: if isOwner(userId)
          && (settingId != 'preferences' || protectedReportFieldsAreUnchanged());
      }

      // Budget history snapshots subcollection
      match /budgetHistory/{monthId} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
